{
  "manifest_version": 3,
  "name": "Ember — Pomodoro Timer",
  "version": "1.4.0",
  "description": "A calm, focused pomodoro timer — plus a one-shot timer and stopwatch. Toolbar countdown, full-page focus view, stats, gentle chimes.",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "storage", "notifications", "offscreen", "idle", "contextMenus", "sidePanel", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ember — Pomodoro Timer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "toggle-timer": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Start or pause the timer"
    },
    "skip-phase": {
      "description": "Skip to the next phase"
    },
    "open-app": {
      "description": "Open the full-page timer"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
